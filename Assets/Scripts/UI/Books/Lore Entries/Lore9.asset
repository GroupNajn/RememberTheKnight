  m_Script: {fileID: 11500000, guid: d8e9c4ee2d087d04d9b8cdf89c4f21bd, type: 3}
  m_Name: Lore9
  m_EditorClassIdentifier: 
  id: Lore_9
  title: The Healing Fountain
  fullText: "The angel's bright light. \nIt restores a part of me.\nA part of my
    soul.\n\nThe fountain gives me strength.\nPurpose.\nResolve.\n\nI feel like I
    have seen this angel before.\nNo...\nI know I have.\n\nYet the fog remains.\nDo
    not get lost in your own thoughts.\n\nFocus on the path ahead, and...\nTry to
    Remember."
